{
  "schemaVersion": 1,
  "id": "spawnoverlay",
  "version": "${version}",
  "name": "Spawn Overlay",
  "description": "A customizable overlay mod focused on mob spawns",
  "authors": [
    "Mrbysco", "ShyNieke"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/spawn-overlay",
    "sources": "https://github.com/Mrbysco/SpawnOverlay",
    "issues": "https://github.com/Mrbysco/SpawnOverlay/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.mrbysco.spawnoverlay.datagen.SpawnDatagen"
    ],
    "main": [
      "com.mrbysco.spawnoverlay.SpawnOverlay"
    ],
    "client": [
      "com.mrbysco.spawnoverlay.SpawnOverlayClient"
    ],
    "modmenu": [
      "com.mrbysco.spawnoverlay.config.OverlayConfigMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*",
    "forgeconfigapiport": ">=21.1.6"
  }
}
  